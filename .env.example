# Database Connection (Supabase PostgreSQL for Production)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Direct URL used for Prisma migrations with Supabase
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://traditionalstay.com"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-32-character-secret-key-here"

# Secure Initial Admin Credentials
ADMIN_EMAIL="admin@traditionalstay.in"
ADMIN_INITIAL_PASSWORD="SecurePassword123!"

# Razorpay Payment Gateway (Test or Live keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# Email Provider (Resend.com API Key)
RESEND_API_KEY="re_123456789_abcdef"

# SMS / OTP Provider (Optional MSG91 or Twilio)
SMS_PROVIDER="CONSOLE"
